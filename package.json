{
  "name": "ai-game-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check": "node tools/telegram/verify.js",
    "check:full": "node tools/telegram/verify.js --full",
    "context": "node tools/telegram/knowledge.js",
    "test:browser": "node tools/browser-check.cjs",
    "telegram": "node tools/telegram/bot.js",
    "telegram:check": "node tools/telegram/bot.js --check",
    "build:web": "node tools/platforms/build.mjs web",
    "build:embed": "node tools/platforms/build.mjs embed",
    "build:telegram": "node tools/platforms/build.mjs telegram",
    "build:platforms": "node tools/platforms/build.mjs all",
    "telegram:setup": "node tools/platforms/telegram-setup.mjs",
    "test:platforms": "node tools/platforms/browser-check.cjs",
    "package:embed": "node tools/platforms/package.mjs",
    "package:portals": "node tools/platforms/package-portals.mjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "playwright": "^1.63.0",
    "sharp": "0.35.5",
    "vite": "7.1.9"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "preact": "11.0.0",
    "three": "0.186.1"
  }
}
